{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Definiciones compartidas",
  "$defs": {
    "index": {
      "description": "Índice relativo a la referencia (= 100). null mientras no se haya estimado.",
      "type": ["number", "null"],
      "minimum": 0
    },
    "cpuScores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["single", "multi"],
      "properties": {
        "single": { "$ref": "#/$defs/index" },
        "multi": { "$ref": "#/$defs/index" }
      }
    },
    "gpuScores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gaming"],
      "properties": {
        "gaming": {
          "description": "Puntuación con la potencia mínima y máxima de power_w. En desktop ambos valores son iguales.",
          "type": "object",
          "additionalProperties": false,
          "required": ["at_min_power", "at_max_power"],
          "properties": {
            "at_min_power": { "$ref": "#/$defs/index" },
            "at_max_power": { "$ref": "#/$defs/index" }
          }
        },
        "compute": { "$ref": "#/$defs/index" }
      }
    },
    "scoreMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "description": "reference: chip de referencia (100 por definición). anchor: estimado a mano desde reviews. interpolated: derivado de anclas de la misma familia. pending: aún sin puntuar.",
          "enum": ["reference", "anchor", "interpolated", "pending"]
        },
        "based_on": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
