{
  "name": "hardware-advisor",
  "version": "0.1.0",
  "description": "Consulta de rendimiento de CPUs y GPUs (laptops y desktops) con puntuación según el uso.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "fetch:wikipedia": "node scripts/fetch-wikipedia.mjs",
    "import:cpus": "node scripts/import-cpus.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:portfolio": "NEXT_PUBLIC_BASE_PATH=/apps/hardware-advisor NEXT_PUBLIC_SITE_URL=https://oswallmoena.cl/apps/hardware-advisor NEXT_PUBLIC_PORTFOLIO_URL=https://oswallmoena.cl next build",
    "test": "node --experimental-strip-types --no-warnings --test src/lib/*.test.ts scripts/lib/*.test.mjs",
    "types:gen": "node scripts/gen-types.mjs",
    "import:gpus": "node scripts/import-gpus.mjs",
    "estimate": "node scripts/estimate-scores.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cheerio": "1.0.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3"
  }
}
